# HELP finops_demo_message Section narrative for dashboard text/table panels
# TYPE finops_demo_message gauge
finops_demo_message{section="A",title="Executive summary",text="Demo invoice $7,335.08 across 25 services. Top driver: Cloud Composer ($1,459.45, 20% of total). Comparable spend is up 36% vs prior period (~$5,329 → $7,266)."} 1
finops_demo_message{section="B",title="Spend by service",text="Ranked 25 services by subtotal; focus top 5 for ownership reviews."} 1
finops_demo_message{section="C",title="Growth & anomalies",text="Fastest riser: Workflows (153%). 3 service(s) marked New."} 1
finops_demo_message{section="D",title="Concentration / Pareto",text="Top 5 services are 69% of the invoice. 7 services cover 80% of spend — ownership reviews should start there."} 1
finops_demo_message{section="E",title="Savings & discounts",text="List cost $7,745 with $217 in recorded savings/discounts (2.8% of list). Largest lines shown below."} 1
finops_demo_message{section="F",title="Waste & opportunities",text="7 opportunities totaling $343/mo addressable — ranked below by estimated recovery, then owned in the action queue."} 1
finops_demo_message{section="G",title="Action queue",text="7 actions queued; top: Investigate 89% MoM spike on Cloud Run Functions — owner: FinOps"} 1
finops_demo_message{section="H",title="Allocation hygiene",text="98% of spend has a demo owner tag. 12 services ($157) still need allocation."} 1
finops_demo_message{section="I",title="Forecast & runway",text="Next period projects ~$8,935 (+1,600) using a dampened MoM. Recovering $343/mo addressable offsets ~0.2 months of that growth."} 1
finops_demo_message{section="J",title="Alerts & messages",text="Active demo alerts: spend_spike, service_growth, open_actions."} 1
finops_demo_message{section="K",title="Governance",text="Weekly triage with FinOps + Platform; monthly finance review. Each fix is verified by regenerating the snapshot from a fresh export."} 1
finops_demo_message{section="meta",title="Disclaimer",text="Synthetic anonymized demo data — not a real customer invoice."} 1
